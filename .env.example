# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Database URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/biz_zolution

# Authentication Security
JWT_SECRET=bizzolution_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Optional - Falls back to safe local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay Sandbox / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email SMTP Delivery (Optional - Falls back to safe console simulator)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@bizzolution.com

# Site Info
SITE_NAME=BizZolution
